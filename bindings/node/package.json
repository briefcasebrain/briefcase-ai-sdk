{
  "name": "@briefcase-ai/native",
  "version": "4.2.0",
  "description": "Native cost engine for briefcase-ai: model pricing and id normalization backed by the Rust core. Ships binaries for Linux x64/arm64 (gnu), macOS x64/arm64, and Windows x64 in one package.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/briefcasebrain/briefcase-ai-sdk.git",
    "directory": "bindings/node"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "engines": {
    "node": ">= 12.22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "napi": {
    "binaryName": "briefcase-native",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "vitest run"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "vitest": "^3.2.4"
  }
}
