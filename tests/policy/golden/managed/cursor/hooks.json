{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "briefcase-ai hook cursor --endpoint https:/''/otel.example.com",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "briefcase-ai hook cursor --endpoint https:/''/otel.example.com",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "briefcase-ai hook cursor --endpoint https:/''/otel.example.com",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "briefcase-ai hook cursor --endpoint https:/''/otel.example.com",
        "timeout": 5
      }
    ],
    "afterAgentResponse": [
      {
        "command": "briefcase-ai hook cursor --endpoint https:/''/otel.example.com",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "briefcase-ai hook cursor --endpoint https:/''/otel.example.com",
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": "briefcase-ai hook cursor --enforce --fail-closed --endpoint https:/''/otel.example.com --require-policy-sha256 bf28356c563bc87bf5e0d347f2993c3aa513dc2903e95609c205be67670e61bc",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "briefcase-ai hook cursor --enforce --fail-closed --endpoint https:/''/otel.example.com --require-policy-sha256 bf28356c563bc87bf5e0d347f2993c3aa513dc2903e95609c205be67670e61bc",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "briefcase-ai hook cursor --enforce --fail-closed --endpoint https:/''/otel.example.com --require-policy-sha256 bf28356c563bc87bf5e0d347f2993c3aa513dc2903e95609c205be67670e61bc",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "briefcase-ai hook cursor --enforce --fail-closed --endpoint https:/''/otel.example.com --require-policy-sha256 bf28356c563bc87bf5e0d347f2993c3aa513dc2903e95609c205be67670e61bc",
        "timeout": 10,
        "matcher": "Write|Delete",
        "failClosed": true
      }
    ]
  }
}
