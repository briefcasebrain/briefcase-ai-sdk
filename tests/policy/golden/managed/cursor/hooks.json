{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "briefcase-ai hook cursor --endpoint https://otel.example.com",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "briefcase-ai hook cursor --endpoint https://otel.example.com",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "briefcase-ai hook cursor --endpoint https://otel.example.com",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "briefcase-ai hook cursor --endpoint https://otel.example.com",
        "timeout": 5
      }
    ],
    "afterAgentResponse": [
      {
        "command": "briefcase-ai hook cursor --endpoint https://otel.example.com",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "briefcase-ai hook cursor --endpoint https://otel.example.com",
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": "briefcase-ai hook cursor --enforce --endpoint https://otel.example.com",
        "timeout": 10
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "briefcase-ai hook cursor --enforce --endpoint https://otel.example.com",
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "command": "briefcase-ai hook cursor --enforce --endpoint https://otel.example.com",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "briefcase-ai hook cursor --enforce --endpoint https://otel.example.com",
        "timeout": 10,
        "matcher": "Write|Delete"
      }
    ]
  }
}
